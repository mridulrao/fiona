# LiveKit
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Public HTTPS domain for this app (must point to your server IP)
DOMAIN=voice.example.com

# Email used by Let's Encrypt via Caddy
ACME_EMAIL=you@example.com

# LLM / voice providers
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVEN_API_KEY=your_elevenlabs_api_key

# Optional server port (defaults to 3001)
PORT=3001

# Optional override for the agent -> web service widget calls.
# In docker-compose this is set automatically to http://web:3001
# WIDGET_SERVER_BASE_URL=http://localhost:3001
# Optional override for observability ingest endpoint used by agent/tools.
# Defaults to WIDGET_SERVER_BASE_URL and then http://localhost:3001
# OBSERVABILITY_API_BASE_URL=http://localhost:3001

DEEPGRAM_NO_DELAY=false
DEEPGRAM_ENDPOINTING_MS=700
LK_MIN_ENDPOINTING_DELAY_MS=1400
LK_MAX_ENDPOINTING_DELAY_MS=6000
BACKCHANNEL_ALLOW_INTERRUPTION=false
BACKCHANNEL_MICRO_PAUSE_MS=160
BACKCHANNEL_EMIT_PROBABILITY=0.1
BACKCHANNEL_COOLDOWN_MS=3500

# LiveKit observability
# Enable/disable Insights recording uploads from the agent session.
LK_AGENT_RECORD=true
# Enable/disable SDK metric logs (TTFT/TTFB/tokens/audio duration) in worker logs.
LK_LOG_SDK_METRICS=true
# Enable/disable custom tool invocation observability logs.
LK_TOOL_OBSERVABILITY=true
# If true, also emits tool telemetry over LiveKit data channel as TOOL_OBSERVABILITY events.
LK_TOOL_OBSERVABILITY_PUBLISH=false
# Enable/disable writing observability events to DB through /observability/events.
LK_DB_OBSERVABILITY_ENABLED=true
# Max turn entries retained per session row in DB.
OBSERVABILITY_MAX_SESSION_TURNS=500

# Postgres DB used by Prisma (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?schema=public
# Direct connection used by Prisma Migrate (do not use the Supabase pooler URL on :6543 here)
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?schema=public
# Optional shadow DB URL for prisma migrate dev (recommended for Supabase)
# SHADOW_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?schema=shadow
# Optional shared secret required on /observability/events ingest.
# OBSERVABILITY_INGEST_KEY=replace_with_a_strong_secret
# Dashboard login credentials (required together to enable dashboard auth)
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=change_me
# Optional dashboard session lifetime in milliseconds (default 28800000 / 8 hours)
# DASHBOARD_SESSION_TTL_MS=28800000

# Short-lived memory PIN (4 digits) for privileged writes
SHORT_LIVED_MEMORY_PIN=1234
MEMORY_API_BASE_URL=http://127.0.0.1:8000
MEMORY_API_KEY_ID=replace_with_memory_api_key_id
MEMORY_API_SECRET=replace_with_memory_api_secret
