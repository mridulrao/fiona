{  
  "compilerOptions": {  
    "target": "es2022",  
    "module": "node16",  
    "moduleResolution": "node16",  
    "outDir": "./dist",  
    "rootDir": "./",  
    "strict": true,  
    "esModuleInterop": true,  
    "skipLibCheck": true,  
    "forceConsistentCasingInFileNames": true,  
    "types": ["node"]  
  },  
  "include": ["agents/agent.ts"],  
  "exclude": ["node_modules", "dist"]  
}